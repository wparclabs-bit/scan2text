{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scan2Text",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Scan2Text",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [],
    "resources": [
      "../../dist/scan2text-backend"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
